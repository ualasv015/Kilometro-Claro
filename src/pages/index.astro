---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, categories } from '../data/tools';
---
<BaseLayout title="Calculadoras para conductores | Kilómetro Claro" description="Calcula el consumo de tu coche, el coste de un viaje y tus gastos por kilómetro con herramientas gratuitas para conductores en España." webSiteSchema={true}>
  <section class="home-hero">
    <div class="wrap home-hero-inner">
      <div class="home-copy"><span class="eyebrow hero-eyebrow"><span></span> HERRAMIENTAS PARA CONDUCTORES</span><h1>Conduce con las<br /><em>cuentas claras.</em></h1><p>Calcula lo que consume tu coche y cuánto te cuesta cada viaje. Sin registros, con tus propios datos.</p><a class="button-primary" href="/herramientas/">Explorar calculadoras <span aria-hidden="true">→</span></a><div class="hero-proof"><span class="proof-icon">✓</span> Gratis · Rápido · En tu navegador</div></div>
      <div class="hero-visual" aria-hidden="true"><div class="road-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="metric-card"><span>Tu próximo viaje</span><strong>¿Cuánto cuesta?</strong><div class="metric-line"><span>Combustible</span><b>calcular →</b></div></div><div class="route-label"><span class="route-dot"></span> KM 0 <span class="route-dash"></span> DESTINO</div><div class="hero-spark">↗</div></div>
    </div>
  </section>
  <section class="wrap home-tools section-space"><div class="section-heading"><div><span class="section-kicker">Empieza aquí</span><h2>Una respuesta para cada trayecto</h2></div><a class="text-link" href="/herramientas/">Todas las herramientas <span aria-hidden="true">→</span></a></div><div class="tool-grid">{tools.slice(0, 3).map((tool) => <ToolCard tool={tool} />)}</div></section>
  <section class="category-band"><div class="wrap category-inner"><div><span class="section-kicker">Explora por tema</span><h2>Encuentra justo lo que necesitas.</h2></div><div class="category-pills">{categories.map((category) => <a href={`/categorias/${category.slug}/`}>{category.name}<span aria-hidden="true">↗</span></a>)}</div></div></section>
</BaseLayout>
