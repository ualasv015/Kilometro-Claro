---
import BaseLayout from '../layouts/BaseLayout.astro';
import { searchItems } from '../data/search';
import { guides } from '../data/guides';
import { tools } from '../data/tools';
import { guideImages } from '../data/guide-images';

const featuredGuide = guides.find((guide) => guide.slug === 'cuanto-cuesta-mantener-coche-mes-espana')!;
const featuredImage = guideImages['cuanto-cuesta-mantener-coche-mes-espana'];
const recentGuides = [
  { slug: 'tipos-traccion-coche', compactTitle: 'Tipos de tracción' },
  { slug: 'tipos-luces-coche', compactTitle: 'Luces del coche' },
  { slug: 'tipos-cambio-automatico', compactTitle: 'Cambios automáticos' },
].map(({ slug, compactTitle }) => ({
  guide: guides.find((guide) => guide.slug === slug)!,
  image: guideImages[slug as keyof typeof guideImages],
  compactTitle,
}));
const featuredTools = [
  { slug: 'consumo-combustible', compactTitle: 'Consumo real' },
  { slug: 'coste-viaje-coche', compactTitle: 'Coste del viaje' },
  { slug: 'coste-anual-coche', compactTitle: 'Coste anual' },
].map(({ slug, compactTitle }) => ({
  tool: tools.find((tool) => tool.slug === slug)!,
  compactTitle,
}));
---

<BaseLayout
  title="Calculadoras de coche: consumo, viaje y coste/km | Kilómetro Claro"
  description="Calcula el consumo de combustible, el coste de un viaje y el gasto por kilómetro. Herramientas gratuitas y guías prácticas para conductores en España."
  webSiteSchema={true}
  hideHeader={true}
>
  <header class="max-home-header">
    <div class="max-home-top wrap">
      <nav class="max-home-social" aria-label="Redes sociales de Kilómetro Claro">
        <a href="https://www.instagram.com/kilometroclaro/" target="_blank" rel="noopener noreferrer" aria-label="Instagram de Kilómetro Claro">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"/><circle cx="12" cy="12" r="4.1"/><circle class="social-dot" cx="17.7" cy="6.5" r="1"/></svg>
        </a>
        <a href="https://x.com/KilometroClaro" target="_blank" rel="noopener noreferrer" aria-label="Kilómetro Claro en X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="x-mark" d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.8 5.7 22H2.5l7.3-8.4L1.8 2h6.5l4.5 6.7L18.9 2Zm-1.1 17.8h1.7L7.3 4.1H5.5l12.3 15.7Z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@kilometro_claro" target="_blank" rel="noopener noreferrer" aria-label="Kilómetro Claro en TikTok">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="tiktok-mark" d="M19.8 7.1a6.3 6.3 0 0 1-3.9-1.4v8.1a6.2 6.2 0 1 1-5.4-6.1v3.4a2.9 2.9 0 1 0 2.1 2.8V2.1h3.3c.2 2 1.8 3.7 3.9 4v1Z"/></svg>
        </a>
      </nav>

      <a class="max-home-logo" href="/" aria-label="Kilómetro Claro, página de inicio">
        <img src="/logo-marca-kilometro-claro.png" alt="Kilómetro Claro" width="96" height="96" fetchpriority="high" />
        <span aria-hidden="true">Kilómetro <strong>Claro</strong></span>
      </a>

      <div class="max-search-control" id="search-control">
        <form class="max-search-panel" role="search" id="home-search-form" aria-label="Buscar en Kilómetro Claro">
          <label class="max-sr-only" for="home-search-input">¿Qué quieres encontrar?</label>
          <input id="home-search-input" type="search" name="q" placeholder="Buscar guías, calculadoras y marcas…" autocomplete="off" aria-controls="home-search-results" aria-describedby="home-search-status" disabled />
          <button class="max-sr-only" type="submit" tabindex="-1" aria-hidden="true">Ver resultados</button>
          <button class="max-search-toggle" id="search-toggle" type="button" aria-label="Abrir búsqueda" aria-expanded="false" aria-controls="home-search-results-panel">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
          </button>
        </form>

        <section class="max-search-results-panel" id="home-search-results-panel" aria-label="Resultados de búsqueda" aria-hidden="true" inert>
          <p class="max-search-status" id="home-search-status" aria-live="polite"></p>
          <ul class="max-search-results" id="home-search-results"></ul>
        </section>
      </div>
    </div>

    <nav class="max-home-nav" aria-label="Secciones principales">
      <a class="max-nav-guides" href="/guias/">Guías </a>
      <a class="max-nav-calculators" href="/calculadoras/">Calculadoras </a>
      <a class="max-nav-brands" href="/marcas/">Marcas</a>
    </nav>

  </header>

  <section class="home-updates" aria-labelledby="home-updates-title">
    <div class="wrap home-updates-inner">
      <header class="home-updates-heading">
        <h1 id="home-updates-title">Calcula el consumo y el coste de tu coche</h1>
        <p>Usa la calculadora de consumo, estima cuánto cuesta un viaje y compara el gasto por kilómetro con herramientas gratuitas y guías para conductores en España.</p>
      </header>

      <article class="home-featured-guide">
        <figure class="home-featured-visual">
          <a class="home-featured-image" href={`/guias/${featuredGuide.slug}/`} aria-label={`Leer: ${featuredGuide.title}`}>
            <img src={featuredImage.src} alt={featuredImage.alt} width={featuredImage.width} height={featuredImage.height} fetchpriority="high" />
            <span>Guía práctica · Costes del coche</span>
          </a>
          {featuredImage.source && <figcaption>Imagen: <a href={featuredImage.source} target="_blank" rel="noopener noreferrer">{featuredImage.author ?? 'Fuente original'}{featuredImage.sourceName ? ` / ${featuredImage.sourceName}` : ''}</a>.</figcaption>}
        </figure>
        <div class="home-featured-copy">
          <span class="home-guide-category">Guía recomendada · {featuredGuide.category}</span>
          <h2><a href={`/guias/${featuredGuide.slug}/`}>{featuredGuide.title}</a></h2>
          <p>{featuredGuide.description}</p>
          <a class="home-guide-cta" href={`/guias/${featuredGuide.slug}/`}>Leer: {featuredGuide.title}</a>
        </div>
      </article>

      <section class="home-recent-guides" aria-labelledby="home-recent-title">
        <div class="home-recent-heading">
          <h2 id="home-recent-title">Guías para seguir explorando</h2>
          <a href="/guias/">Ver todas las guías </a>
        </div>
        <div class="home-guide-cards">
          {recentGuides.map(({ guide, image, compactTitle }) => (
            <article class="home-guide-card">
              <a class="home-guide-image" href={`/guias/${guide.slug}/`} aria-label={`Leer: ${guide.title}`}>
                <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
              </a>
              <div class="home-guide-card-copy">
                <span class="home-guide-category">{guide.category}</span>
                <h3><a href={`/guias/${guide.slug}/`} aria-label={guide.title}><span class="home-guide-title-full">{guide.title}</span><span class="home-guide-title-mobile">{compactTitle}</span></a></h3>
                <p>{guide.description}</p>
                <a class="home-guide-cta" href={`/guias/${guide.slug}/`}>Leer guía </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="home-featured-tools" aria-labelledby="home-tools-title">
        <div class="home-tools-heading">
          <h2 id="home-tools-title">Calculadoras para tus gastos</h2>
          <a href="/calculadoras/">Ver todas</a>
        </div>
        <div class="home-tool-cards">
          {featuredTools.map(({ tool, compactTitle }, index) => (
            <article class="home-tool-card">
              <a href={`/calculadoras/${tool.slug}/`} aria-label={`Abrir ${tool.title}`}>
                <span class="home-tool-index">0{index + 1}</span>
                <h3><span class="home-tool-title-full">{tool.shortTitle}</span><span class="home-tool-title-mobile">{compactTitle}</span></h3>
                <p>{tool.description}</p>
                <span class="home-tool-open"><span class="home-tool-open-full">Usar {tool.shortTitle}</span><span class="home-tool-open-mobile">Usar</span></span>
              </a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>

  <script define:vars={{ searchItems }}>
    const toggle = document.querySelector('#search-toggle');
    const control = document.querySelector('#search-control');
    const resultsPanel = document.querySelector('#home-search-results-panel');
    const form = document.querySelector('#home-search-form');
    const input = document.querySelector('#home-search-input');
    const results = document.querySelector('#home-search-results');
    const status = document.querySelector('#home-search-status');

    const normalize = (value) => value
      .toLocaleLowerCase('es')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();

    const updateResultsVisibility = () => {
      const hasQuery = Boolean(input.value.trim());
      const isVisible = control.classList.contains('is-open') && hasQuery;
      control.classList.toggle('has-query', hasQuery);
      resultsPanel.setAttribute('aria-hidden', String(!isVisible));
      if (isVisible) resultsPanel.removeAttribute('inert');
      else resultsPanel.setAttribute('inert', '');
    };

    const renderResults = () => {
      const query = normalize(input.value);
      results.replaceChildren();
      updateResultsVisibility();

      if (!query) {
        status.textContent = '';
        return;
      }

      const matches = searchItems.filter((item) => normalize(`${item.title} ${item.description} ${item.type} ${item.keywords}`).includes(query)).slice(0, 8);
      status.textContent = matches.length
        ? `${matches.length} resultado${matches.length === 1 ? '' : 's'}${matches.length === 8 ? ' (mostrando hasta 8)' : ''}.`
        : 'No hemos encontrado resultados. Prueba con otra palabra.';

      for (const item of matches) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        const type = document.createElement('span');
        const title = document.createElement('strong');
        const description = document.createElement('small');

        link.href = item.href;
        type.className = `max-result-type ${item.type === 'Guía' ? 'max-result-type--guide' : item.type === 'Calculadora' ? 'max-result-type--calculator' : 'max-result-type--brand'}`;
        type.textContent = item.type;
        title.textContent = item.title;
        description.textContent = item.description.length > 96
          ? `${item.description.slice(0, 93).trimEnd()}…`
          : item.description;
        link.append(type, title, description);
        li.append(link);
        results.append(li);
      }
    };

    const setSearchOpen = (isOpening) => {
      control.classList.toggle('is-open', isOpening);
      toggle.setAttribute('aria-expanded', String(isOpening));
      toggle.setAttribute('aria-label', isOpening ? 'Cerrar búsqueda' : 'Abrir búsqueda');

      if (isOpening) {
        input.disabled = false;
        updateResultsVisibility();
        window.requestAnimationFrame(() => input.focus());
      } else {
        updateResultsVisibility();
        toggle.focus();
        input.disabled = true;
      }
    };

    toggle.addEventListener('click', () => setSearchOpen(!control.classList.contains('is-open')));

    input.addEventListener('input', renderResults);
    const goToSearchResults = () => {
      const query = input.value.trim();
      if (query) window.location.assign(`/buscar/?q=${encodeURIComponent(query)}`);
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      goToSearchResults();
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        goToSearchResults();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && control.classList.contains('is-open')) setSearchOpen(false);
    });
  </script>
</BaseLayout>

<style>
  .max-home-header {
    position: relative;
    z-index: 2;
    padding: 18px 0 21px;
    border-bottom: 3px solid #172c27;
    background: #173d34;
    color: #f8f7ef;
    box-shadow: 0 5px 0 #d9f36a;
  }

  .max-home-top {
    position: relative;
    display: grid;
    min-height: 106px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .max-home-social {
    display: flex;
    align-items: center;
    justify-self: start;
    gap: 10px;
  }

  .max-home-social a,
  .max-search-toggle {
    display: grid;
    width: 43px;
    height: 43px;
    place-items: center;
    border: 2px solid #172c27;
    border-radius: 12px;
    background: #fff;
    color: #172c27;
    box-shadow: 3px 3px 0 #172c27;
    transition: transform .16s, box-shadow .16s, background-color .16s;
  }

  .max-home-social a:hover,
  .max-search-toggle:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 #172c27;
    background: #d9f36a;
  }

  .max-home-social a:focus-visible,
  .max-search-toggle:focus-visible,
  .max-home-nav a:focus-visible,
  .max-search-panel a:focus-visible,
  .max-search-panel button:focus-visible,
  .max-search-panel input:focus-visible {
    outline: 3px solid #f07842;
    outline-offset: 4px;
  }

  .max-home-social svg,
  .max-search-toggle svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .max-home-social .social-dot { fill: currentColor; stroke: none; }
  .max-home-social .x-mark,
  .max-home-social .tiktok-mark { fill: currentColor; stroke: none; }

  .max-home-logo {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 13px;
    transform: rotate(-2deg);
  }

  .max-home-logo img { display: block; width: 84px; height: 84px; border-radius: 24px; object-fit: cover; box-shadow: 5px 5px 0 #d9f36a; }
  .max-home-logo > span { color: #f8f7ef; font-size: 23px; font-weight: 700; letter-spacing: -1px; white-space: nowrap; }
  .max-home-logo > span strong { color: #d9f36a; font-weight: 900; }

  .max-search-control {
    grid-column: 3;
    position: relative;
    z-index: 5;
    justify-self: end;
    width: 47px;
    height: 47px;
    transition: width .38s cubic-bezier(.2,.8,.2,1);
  }

  .max-search-control.is-open { width: min(430px, calc(100vw - 150px)); }

  .max-home-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 13px;
    margin: 12px auto 0;
    padding: 0 20px;
  }

  .max-home-nav a {
    display: inline-flex;
    min-width: 156px;
    min-height: 48px;
    justify-content: center;
    align-items: center;
    gap: 20px;
    padding: 10px 18px;
    border: 2px solid #172c27;
    border-radius: 8px;
    box-shadow: 4px 4px 0 #172c27;
    font-size: 14px;
    font-weight: 850;
    letter-spacing: -.2px;
    transition: transform .16s, box-shadow .16s;
  }

  .max-home-nav a:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 #172c27;
  }

  .max-home-nav a span { font-size: 17px; }
  .max-nav-guides { background: #d9f36a; color: #172c27; }
  .max-nav-guides span { color: #173d34; }
  .max-nav-calculators { background: #f8f7ef; color: #172c27; }
  .max-nav-brands { background: #173d34; color: #fff; }

  .max-search-panel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 2px solid #172c27;
    border-radius: 12px;
    background: #fffef8;
    box-shadow: 8px 8px 0 #172c27;
    overflow: hidden;
    transition: box-shadow .2s, background-color .2s;
  }

  .max-search-control:not(.is-open) .max-search-panel { padding: 0; }
  .max-search-panel input {
    min-width: 0;
    width: 0;
    height: 100%;
    flex: 1 1 auto;
    padding: 0;
    border: 0;
    outline: 0;
    opacity: 0;
    color: #172c27;
    background: transparent;
    font-size: 14px;
    pointer-events: none;
    transition: width .32s ease .04s, padding .32s ease .04s, opacity .18s ease;
  }

  .max-search-panel input::placeholder { color: #68766e; }
  .max-search-control.is-open .max-search-panel input { width: 100%; padding: 0 14px; opacity: 1; pointer-events: auto; }
  .max-search-toggle {
    display: grid;
    width: 43px;
    height: 43px;
    flex: 0 0 43px;
    place-items: center;
    border: 0;
    border-left: 2px solid #172c27;
    border-radius: 0 9px 9px 0;
    background: #d9f36a;
    color: #172c27;
    cursor: pointer;
    box-shadow: none;
    transition: background-color .16s;
  }

  .max-search-control:not(.is-open) .max-search-toggle { width: 43px; height: 43px; border: 0; border-radius: 9px; background: #fff; }
  .max-search-toggle:hover,
  .max-search-control:not(.is-open) .max-search-toggle:hover { transform: none; box-shadow: none; background: #d9f36a; }
  .max-search-control.is-open .max-search-panel { box-shadow: 5px 5px 0 #172c27; }

  .max-search-results-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 6;
    width: min(100%, 430px);
    max-height: min(65vh, 540px);
    overflow: auto;
    padding: 16px;
    border: 2px solid #172c27;
    border-radius: 12px;
    background: #fffef8;
    box-shadow: 7px 7px 0 #172c27;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px) scale(.985);
    transform-origin: top right;
    transition: opacity .2s ease, transform .28s cubic-bezier(.2,.8,.2,1), visibility 0s linear .28s;
  }

  .max-search-control.is-open.has-query .max-search-results-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition-delay: .05s, .05s, 0s;
  }

  .max-search-status { margin: 12px 0 0; color: #536159; font-size: 12px; line-height: 1.5; }
  .max-search-results { display: grid; gap: 8px; margin: 12px 0 0; padding: 0; list-style: none; }
  .max-search-results:empty { display: none; }
  :global(.max-search-results a) { display: grid; gap: 4px; padding: 11px 12px; border: 1px solid #d7ddd3; border-radius: 7px; color: #172c27; }
  :global(.max-search-results a:hover) { border-color: #172c27; background: #f1f5e8; }
  :global(.max-search-results strong) { font-size: 13px; font-weight: 850; }
  :global(.max-search-results small) { color: #536159; font-size: 11px; line-height: 1.45; }
  :global(.max-result-type) { width: fit-content; padding: 4px 7px; border-radius: 4px; font-size: 9px; font-weight: 900; letter-spacing: .65px; line-height: 1.2; text-transform: uppercase; }
  :global(.max-result-type--guide) { background: #173d34; color: #fff; }
  :global(.max-result-type--calculator) { background: #d9f36a; color: #172c27; }
  :global(.max-result-type--brand) { background: #173d34; color: #d9f36a; }

  .home-updates { padding: clamp(24px, 3.5vw, 40px) 0 88px; background: linear-gradient(128deg, #e8f1c9 0%, #f8f7ef 46%, #dcece4 100%); color: #172c27; }
  .home-updates-heading { max-width: 780px; margin: 0 auto 38px; text-align: center; }
  .home-updates-heading h1 { margin: 15px 0 9px; color: #173d34; font: 900 clamp(48px, 8vw, 88px)/.95 Manrope, Arial, sans-serif; letter-spacing: -4px; }
  .home-updates-heading p { margin: 0; color: #536159; font-size: 16px; line-height: 1.6; }

  .home-featured-guide { display: grid; grid-template-columns: 1.08fr .92fr; overflow: hidden; border: 3px solid #172c27; border-radius: 12px; background: #d9f36a; box-shadow: 9px 9px 0 #172c27; transition: transform .2s ease, box-shadow .2s ease; }
  .home-featured-guide:focus-within { transform: translate(-3px,-3px); box-shadow: 12px 12px 0 #172c27; }
  .home-featured-guide:focus-within .home-featured-image img { transform: scale(1.025); }
  @media (hover:hover) {
    .home-featured-guide:hover { transform: translate(-3px,-3px); box-shadow: 12px 12px 0 #172c27; }
    .home-featured-guide:hover .home-featured-image img { transform: scale(1.025); }
  }
  .home-featured-visual { display: flex; min-width: 0; min-height: 370px; flex-direction: column; margin: 0; background: #173d34; }
  .home-featured-image { position: relative; display: block; min-width: 0; min-height: 0; flex: 1; overflow: hidden; background: #173d34; }
  .home-featured-image img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; transition: transform .28s ease; }
  .home-featured-image > span { position: absolute; left: 14px; bottom: 14px; padding: 7px 9px; border: 1px solid #172c27; border-radius: 4px; background: #f8f7ef; color: #172c27; font-size: 10px; font-weight: 750; }
  .home-featured-visual figcaption { padding: 7px 11px 8px; background: #f8f7ef; color: #536159; font-size: 10px; line-height: 1.4; }
  .home-featured-visual figcaption a { color: #173d34; text-decoration: underline; text-underline-offset: 2px; }
  .home-featured-copy { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(25px, 4vw, 49px); }
  .home-guide-category { display: inline-block; padding: 6px 8px; border-radius: 4px; background: #173d34; color: #fff; font-size: 9px; font-weight: 900; letter-spacing: .8px; line-height: 1.3; text-transform: uppercase; }
  .home-featured-copy h2 { margin: 20px 0 12px; color: #173d34; font: 850 clamp(28px, 3.5vw, 43px)/1.05 Manrope, Arial, sans-serif; letter-spacing: -1.7px; }
  .home-featured-copy h2 a:hover,.home-guide-card h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .home-featured-copy p { margin: 0 0 22px; color: #34483f; font-size: 14px; line-height: 1.7; }
  .home-guide-cta { display: inline-flex; min-height: 42px; align-items: center; gap: 20px; margin-top: auto; padding: 10px 13px; border: 1px solid #173d34; border-radius: 5px; background: #173d34; color: #fff; font-size: 11px; font-weight: 800; }
