---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, categories } from '../data/tools';
import { guides } from '../data/guides';
const featuredGuideSlugs = ['como-reducir-consumo-combustible', 'consumo-coche-electrico-gasolina-diesel', 'que-coche-comprar-segun-presupuesto'];
const homeGuides = guides.filter((guide) => featuredGuideSlugs.includes(guide.slug) && guide.published);
---
<BaseLayout title="Guías y calculadoras para conductores | Kilómetro Claro" description="Guías claras para entender el consumo, los gastos del coche y el coste de viajar. Acompáñalas con calculadoras gratuitas para tus propios datos." webSiteSchema={true}>
  <section class="home-hero">
    <div class="wrap home-hero-inner">
      <div class="home-copy"><span class="eyebrow hero-eyebrow"><span></span> GUÍAS PARA CONDUCTORES</span><h1>Entiende lo que<br />cuesta <em>conducir.</em></h1><p>Ideas claras sobre consumo, viajes y gastos del coche, con herramientas para llevar cada explicación a tus propios números.</p><a class="button-primary" href="/guias/">Explorar las guías <span aria-hidden="true">→</span></a><div class="hero-proof"><span class="proof-icon">✓</span> Sin tecnicismos · Con tus datos</div></div>
      <div class="hero-visual" aria-hidden="true"><div class="road-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="metric-card"><span>El coste de conducir</span><strong>Entenderlo cambia todo</strong><div class="metric-line"><span>Guías prácticas</span><b>leer →</b></div></div><div class="route-label"><span class="route-dot"></span> CONSUMO <span class="route-dash"></span> COSTES</div><div class="hero-spark">↗</div></div>
    </div>
  </section>
  <section class="wrap home-guides section-space" aria-labelledby="home-guides-heading">
    <div class="section-heading"><div><span class="section-kicker">Lee y resuelve</span><h2 id="home-guides-heading">Guías para entender cada gasto</h2></div><a class="text-link" href="/guias/">Todas las guías <span aria-hidden="true">→</span></a></div>
    <div class="guide-grid">{homeGuides.map((guide, index) => <a class="home-guide-card" href={`/guias/${guide.slug}/`}><span class="guide-card-top"><span class="guide-number">0{index + 1}</span><span class="guide-category">{guide.category}</span></span><h3>{guide.title}</h3><p>{guide.description}</p><span class="guide-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>
  <section class="wrap home-tools section-space"><div class="section-heading"><div><span class="section-kicker">Empieza aquí</span><h2>Una respuesta para cada trayecto</h2></div><a class="text-link" href="/herramientas/">Todas las herramientas <span aria-hidden="true">→</span></a></div><div class="tool-grid">{tools.slice(0, 3).map((tool) => <ToolCard tool={tool} />)}</div></section>
  <section class="category-band"><div class="wrap category-inner"><div><span class="section-kicker">Explora por tema</span><h2>Encuentra justo lo que necesitas.</h2></div><div class="category-pills">{categories.map((category) => <a href={`/categorias/${category.slug}/`}>{category.name}<span aria-hidden="true">↗</span></a>)}</div></div></section>
</BaseLayout>
<style>
  .home-guides{padding-top:64px;padding-bottom:68px}.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.home-guide-card{min-height:220px;position:relative;display:flex;flex-direction:column;padding:21px;background:#fff;border:1px solid #e1e7e0;border-radius:8px;transition:transform .18s,border-color .18s}.home-guide-card:hover{transform:translateY(-3px);border-color:#a9bcae}.guide-card-top{display:flex;align-items:center;gap:10px}.guide-number{font:700 11px Manrope,Arial,sans-serif;color:#658276}.guide-category{font-size:9px;letter-spacing:.8px;text-transform:uppercase;color:#77867d}.home-guide-card h3{max-width:280px;margin:27px 22px 14px 0;font:700 20px/1.25 Manrope,Arial,sans-serif;letter-spacing:-.5px}.home-guide-card p{margin:0 15px 24px 0;color:#64716c;font-size:12px;line-height:1.7}.guide-status{margin-top:auto;color:#72847a;font-size:10px}.guide-arrow{position:absolute;right:20px;bottom:19px;color:var(--green);font-size:18px}.home-tools{padding-top:52px}
  @media(max-width:760px){.home-guides{padding-top:47px;padding-bottom:49px}.guide-grid{grid-template-columns:1fr;gap:10px}.home-guide-card{min-height:160px;padding:18px}.home-guide-card h3{font-size:18px;margin-top:20px}.home-guide-card p{margin-bottom:20px}.home-tools{padding-top:35px}}
</style>
