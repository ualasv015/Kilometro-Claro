---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import AdsterraInlineBanner from '../components/ads/AdsterraInlineBanner.astro';
import AdsterraNativeBanner from '../components/ads/AdsterraNativeBanner.astro';
import { tools, categories } from '../data/tools';
import { guides } from '../data/guides';
import { guideImages } from '../data/guide-images';
const trendingGuideSlug = 'porsche-mission-s-2026';
const trendingGuide = guides.find((guide) => guide.slug === trendingGuideSlug && guide.published);
const trendingImage = guideImages[trendingGuideSlug];
const featuredGuideSlugs = ['como-reducir-consumo-combustible', 'consumo-coche-electrico-gasolina-diesel', 'coches-baratos-espana'];
const homeGuides = guides.filter((guide) => featuredGuideSlugs.includes(guide.slug) && guide.published);
const featuredToolSlugs = ['consumo-combustible', 'coste-carga-coche-electrico', 'simulador-financiacion-coche'];
const featuredTools = featuredToolSlugs.flatMap((slug) => tools.filter((tool) => tool.slug === slug));
---
<BaseLayout title="Guías y calculadoras para conductores | Kilómetro Claro" description="Aprende a calcular el consumo de combustible, el coste de viajar y los gastos de tu coche con guías prácticas y calculadoras gratuitas para España." webSiteSchema={true}>
  <section class="home-hero">
    <div class="wrap home-hero-inner">
      <div class="home-copy">
        <span class="eyebrow hero-eyebrow"><span></span> GUÍAS Y CALCULADORAS PARA CONDUCTORES</span>
        <h1>Entiende lo que<br />cuesta <em>conducir.</em></h1>
        <p class="hero-lead">El consumo de combustible, un viaje o la compra de un coche no tienen un precio igual para todos. Dependen de los kilómetros que haces, del vehículo que utilizas y de las decisiones que tomas por el camino.</p>
        <p class="hero-support">En Kilómetro Claro explicamos cómo hacer esas cuentas, qué datos conviene comprobar y dónde suelen aparecer gastos olvidados. Después puedes usar nuestras calculadoras gratuitas para probar tus propios escenarios.</p>
        <div class="hero-actions"><a class="button-primary" href="/guias/">Explorar las guías <span aria-hidden="true">→</span></a><a class="hero-secondary" href="/herramientas/">Usar las calculadoras <span aria-hidden="true">↗</span></a></div>
        <div class="hero-proof"><span class="proof-icon">✓</span> Sin registro · Con supuestos y resultados explicados</div>
      </div>
      <aside class="home-reading-panel" aria-labelledby="home-reading-heading">
        <span class="panel-kicker">Empieza por tu duda</span>
        <h2 id="home-reading-heading">Tres preguntas que merece la pena resolver</h2>
        <p class="panel-intro">Lee el método, revisa sus límites y pasa de la explicación a tus cifras.</p>
        <div class="reading-list">
          <a href="/guias/como-calcular-consumo-real-coche/"><span class="reading-number">01</span><span><strong>¿Cuánto consume realmente mi coche?</strong><small>Mide litros y kilómetros entre repostajes para obtener un dato propio.</small></span><span class="reading-arrow" aria-hidden="true">↗</span></a>
          <a href="/guias/cuanto-cuesta-viaje-coche/"><span class="reading-number">02</span><span><strong>¿Qué presupuesto necesito para un viaje?</strong><small>Separa combustible, peajes y aparcamiento antes de sumar el total.</small></span><span class="reading-arrow" aria-hidden="true">↗</span></a>
          <a href="/guias/que-coche-comprar-segun-presupuesto/"><span class="reading-number">03</span><span><strong>¿Qué coche encaja en mi presupuesto?</strong><small>Compara el precio de compra con el uso que le darás y sus gastos.</small></span><span class="reading-arrow" aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
  </section>
  <AdsterraInlineBanner />
  {trendingGuide && trendingImage && <section class="wrap home-latest" aria-labelledby="home-latest-heading">
    <div class="latest-heading"><div><span class="section-kicker">Actualidad del motor</span><h2 id="home-latest-heading">Novedades</h2></div><span class="latest-highlight"><span aria-hidden="true"></span> EN PORTADA</span></div>
    <a class="latest-card" href={`/guias/${trendingGuide.slug}/`}>
      <span class="latest-image"><img src={trendingImage.src} alt={trendingImage.alt} width={trendingImage.width} height={trendingImage.height} loading="lazy" decoding="async" /><span class="latest-image-caption">Queens, Nueva York · Imagen ilustrativa</span></span>
      <span class="latest-content"><span class="latest-meta">19 DE OCTUBRE DE 2026 <span aria-hidden="true">·</span> ANÁLISIS</span><strong class="latest-title">{trendingGuide.title}</strong><span class="latest-summary">Porsche prepara un superdeportivo de motor central por encima del 911. Repasamos lo confirmado, sus posibles rivales y el futuro de ambos modelos.</span><span class="latest-link">Leer la guía <span aria-hidden="true">↗</span></span></span>
    </a>
  </section>}
  <section class="wrap home-guides section-space" aria-labelledby="home-guides-heading">
    <div class="section-heading"><div><span class="section-kicker">Lee y resuelve</span><h2 id="home-guides-heading">Guías para entender cada gasto</h2></div><a class="text-link" href="/guias/">Todas las guías <span aria-hidden="true">→</span></a></div>
    <p class="home-section-intro">Una selección de lecturas sobre hábitos de conducción, movilidad eléctrica y compra de coche. Cada guía plantea una pregunta concreta y te ayuda a distinguir los datos comprobables de los supuestos que dependen de tu caso.</p>
    <div class="guide-grid">{homeGuides.map((guide, index) => <a class="home-guide-card" href={`/guias/${guide.slug}/`}><span class="guide-card-top"><span class="guide-number">0{index + 1}</span><span class="guide-category">{guide.category}</span></span><h3>{guide.title}</h3><p>{guide.description}</p><span class="guide-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>
  <AdsterraNativeBanner />
  <section class="wrap home-tools section-space"><div class="section-heading"><div><span class="section-kicker">Pon tus números</span><h2>Calculadoras para pasar de la idea al dato</h2></div><a class="text-link" href="/herramientas/">Todas las herramientas <span aria-hidden="true">→</span></a></div><p class="home-section-intro">Introduce tu distancia, consumo, tarifa o presupuesto según la herramienta. Puedes cambiar los valores y comparar escenarios sin crear una cuenta; los resultados son estimaciones para ayudarte a decidir, no precios cerrados.</p><div class="tool-grid">{featuredTools.map((tool) => <ToolCard tool={tool} />)}</div></section>
  <section class="category-band"><div class="wrap category-inner"><div><span class="section-kicker">Explora por tema</span><h2>Encuentra justo lo que necesitas.</h2><p class="category-intro">Reunimos guías y calculadoras relacionadas para que puedas seguir investigando un tema sin perder el contexto: consumo, costes del coche, movilidad eléctrica y compra.</p></div><div class="category-pills">{categories.map((category) => <a href={`/categorias/${category.slug}/`}>{category.name}<span aria-hidden="true">↗</span></a>)}</div></div></section>
</BaseLayout>
<style>
  .home-hero-inner{grid-template-columns:minmax(0,1.04fr) minmax(0,.96fr);gap:54px}.home-copy{padding-block:58px}.home-copy .hero-lead{margin-bottom:12px}.home-copy .hero-support{margin-bottom:24px;font-size:14px;color:#b8d0c4}.hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:20px}.hero-secondary{color:#e9f2eb;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.hero-secondary:hover{color:var(--lime)}.hero-proof{margin-top:18px}
  .home-reading-panel{color:var(--ink);background:#f8faf5;border:1px solid #ffffff4a;border-radius:10px;padding:27px 27px 14px;box-shadow:0 22px 55px #0b2a2055}.panel-kicker{display:block;color:var(--green);font-size:10px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase}.home-reading-panel h2{font:700 23px/1.24 Manrope,Arial,sans-serif;letter-spacing:-.6px;margin:10px 0 7px}.panel-intro{color:#637268;font-size:12px;line-height:1.6;margin:0 0 9px}.reading-list a{display:grid;grid-template-columns:25px minmax(0,1fr) 17px;gap:12px;align-items:start;border-top:1px solid #e0e8df;padding:15px 0}.reading-list a:hover strong,.reading-list a:focus-visible strong{text-decoration:underline;text-underline-offset:3px}.reading-number{color:#639277;font:800 11px Manrope,Arial,sans-serif;padding-top:2px}.reading-list strong{display:block;font:700 13px/1.4 Manrope,Arial,sans-serif}.reading-list small{display:block;color:#69776e;font-size:11px;line-height:1.55;margin-top:4px}.reading-arrow{color:var(--green);font-size:16px}
  .home-latest{padding-top:42px}.latest-heading{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:15px}.latest-heading h2{margin:6px 0 0;color:var(--ink);font:700 29px/1.15 Manrope,Arial,sans-serif;letter-spacing:-.8px}.latest-highlight{display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border-radius:30px;background:#eaf1e5;color:#315747;font-size:9px;font-weight:800;letter-spacing:.9px;white-space:nowrap}.latest-highlight span{width:6px;height:6px;border-radius:50%;background:#72a147}.latest-card{display:grid;grid-template-columns:minmax(0,37%) minmax(0,1fr);min-height:225px;overflow:hidden;border:1px solid #dbe5d9;border-radius:10px;background:#fff;transition:border-color .18s,transform .18s,box-shadow .18s}.latest-card:hover{border-color:#9dbca7;transform:translateY(-2px);box-shadow:0 12px 28px #173d3414}.latest-card:focus-visible{outline:3px solid #72a147;outline-offset:3px}.latest-image{position:relative;display:block;min-height:225px;overflow:hidden;background:#d9e2dd}.latest-image img{display:block;width:100%;height:100%;position:absolute;inset:0;object-fit:cover;object-position:center 44%;transition:transform .25s}.latest-card:hover img{transform:scale(1.035)}.latest-image-caption{position:absolute;left:13px;bottom:12px;padding:6px 9px;border-radius:4px;background:#173d34db;color:#fff;font-size:9px;line-height:1.3}.latest-content{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:28px 35px}.latest-meta{color:#577963;font-size:10px;font-weight:800;letter-spacing:1px}.latest-meta span{padding-inline:6px;color:#95aa9c}.latest-title{display:block;max-width:600px;margin:12px 0 10px;color:var(--ink);font:700 25px/1.25 Manrope,Arial,sans-serif;letter-spacing:-.6px}.latest-summary{display:block;max-width:610px;color:#5f6e64;font-size:13px;line-height:1.65}.latest-link{display:inline-flex;align-items:center;gap:13px;margin-top:16px;color:var(--green);font-size:12px;font-weight:800}.latest-link span{font-size:16px}.latest-card:hover .latest-link{text-decoration:underline;text-underline-offset:3px}
  .home-guides{padding-top:64px;padding-bottom:68px}.home-section-intro{max-width:760px;color:#596960;font-size:14px;line-height:1.7;margin:-2px 0 25px}.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.home-guide-card{min-height:220px;position:relative;display:flex;flex-direction:column;padding:21px;background:#fff;border:1px solid #e1e7e0;border-radius:8px;transition:transform .18s,border-color .18s}.home-guide-card:hover{transform:translateY(-3px);border-color:#a9bcae}.guide-card-top{display:flex;align-items:center;gap:10px}.guide-number{font:700 11px Manrope,Arial,sans-serif;color:#658276}.guide-category{font-size:9px;letter-spacing:.8px;text-transform:uppercase;color:#77867d}.home-guide-card h3{max-width:280px;margin:27px 22px 14px 0;font:700 20px/1.25 Manrope,Arial,sans-serif;letter-spacing:-.5px}.home-guide-card p{margin:0 15px 24px 0;color:#64716c;font-size:12px;line-height:1.7}.guide-arrow{position:absolute;right:20px;bottom:19px;color:var(--green);font-size:18px}.home-tools{padding-top:52px}.category-intro{max-width:350px;color:#c0d3c8;font-size:13px;line-height:1.65;margin:12px 0 0}
  @media(max-width:760px){.home-hero-inner{grid-template-columns:1fr;gap:0}.home-copy{padding:42px 0 27px}.home-copy .hero-lead{font-size:14px}.home-copy .hero-support{font-size:13px}.home-reading-panel{padding:22px 20px 8px;margin-bottom:34px}.home-reading-panel h2{font-size:21px}.hero-actions{gap:15px}.home-latest{padding-top:35px}.latest-heading h2{font-size:24px}.latest-highlight{font-size:8px;padding:7px 9px}.latest-card{grid-template-columns:1fr}.latest-image{min-height:172px}.latest-image-caption{font-size:8px;left:10px;bottom:10px}.latest-content{padding:21px 20px 23px}.latest-meta{font-size:9px}.latest-title{font-size:21px;margin:10px 0 8px}.latest-summary{font-size:12px}.latest-link{margin-top:12px}.home-guides{padding-top:43px;padding-bottom:49px}.home-section-intro{font-size:13px;margin:0 0 21px}.guide-grid{grid-template-columns:1fr;gap:10px}.home-guide-card{min-height:160px;padding:18px}.home-guide-card h3{font-size:18px;margin-top:20px}.home-guide-card p{margin-bottom:20px}.home-tools{padding-top:35px}.category-intro{max-width:540px;font-size:12px}}
</style>
