---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';
import { categories, tools } from '../../data/tools';
import '../../styles/maximalist-listings.css';

const categoryTools = categories
  .map((category) => ({
    category,
    tools: category.tools.map((slug) => tools.find((tool) => tool.slug === slug)).filter(Boolean),
  }))
  .filter((group) => group.tools.length > 0);
---

<BaseLayout title="Calculadoras de coche gratuitas | Kilómetro Claro" description="Calcula consumos, viajes y gastos del coche con herramientas gratuitas. Introduce tus propios datos y compara resultados en euros, kilómetros y litros.">
  <div class="wrap page-wrap maximalist-directory calculator-directory">
    <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Calculadoras' }]} />

    <header class="directory-hero directory-hero--calculators">
      <div class="directory-hero-copy">
        <span class="directory-kicker">Kilómetro Claro · Herramientas</span>
        <h1>Haz números.<br /><em>Decide mejor.</em></h1>
        <p>Calculadoras gratuitas para estimar consumo, viajes y coste de uso. Introduce tus propios kilómetros, precios y gastos para que el resultado se parezca a tu realidad.</p>
        <a class="directory-hero-link" href="#calculadoras-temas">Ver herramientas</a>
      </div>
      <div class="directory-hero-mark" aria-label={`${tools.length} calculadoras disponibles`}>
        <span>HERRAMIENTAS</span>
        <strong>{String(tools.length).padStart(2, '0')}</strong>
        <small>GRATUITAS</small>
      </div>
    </header>

    <nav class="directory-jump" id="calculadoras-temas" aria-label="Temas de las calculadoras">
      <span>Ir a un tema</span>
      {categoryTools.map(({ category }) => <a href={`#${category.slug}`}>{category.name}</a>)}
    </nav>

    <div class="directory-groups">
      {categoryTools.map(({ category, tools: groupTools }, groupIndex) => (
        <section id={category.slug} class="directory-group calculator-group" aria-labelledby={`${category.slug}-heading`}>
          <header class="directory-group-heading">
            <span class="directory-group-index">{String(groupIndex + 1).padStart(2, '0')}</span>
            <div>
              <span class="directory-group-kicker">Calculadoras</span>
              <h2 id={`${category.slug}-heading`}>{category.name}</h2>
              <p>{category.description}</p>
            </div>
            <span class="directory-group-count">{groupTools.length} {groupTools.length === 1 ? 'herramienta' : 'herramientas'}</span>
          </header>
          <div class="directory-tool-grid">
            {groupTools.map((tool) => <ToolCard tool={tool} />)}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
