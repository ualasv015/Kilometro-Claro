---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';
import { categories, tools } from '../../data/tools';
export function getStaticPaths() { return categories.map((category) => ({ params: { slug: category.slug }, props: { category } })); }
const { category } = Astro.props;
const categoryTools = category.tools.map((slug: string) => tools.find((tool) => tool.slug === slug)).filter(Boolean);
---
<BaseLayout title={`${category.name} | Kilómetro Claro`} description={category.description}>
  <div class="wrap page-wrap"><Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Categorías', href: '/categorias/' }, { label: category.name }]} /><section class="listing-hero"><span class="eyebrow">Categoría</span><h1>{category.name}</h1><p>{category.description}</p></section><div class="tool-grid listing-grid">{categoryTools.map((tool) => <ToolCard tool={tool} />)}</div>{category.slug === 'costes-del-coche' && <aside class="category-guide"><span class="eyebrow">Guía destacada</span><h2>¿Cuánto cuesta mantener un coche al mes?</h2><p>Consulta un desglose de gastos habituales en España y aprende a calcular tu propio presupuesto.</p><a class="text-link" href="/guias/cuanto-cuesta-mantener-coche-mes-espana/">Leer la guía <span aria-hidden="true">→</span></a></aside>}</div>
</BaseLayout>
<style>.category-guide{max-width:760px;margin-top:30px;padding:22px 24px;background:#edf1eb;border-radius:7px}.category-guide h2{font:700 20px Manrope,Arial,sans-serif;margin:8px 0}.category-guide p{font-size:12px;line-height:1.65;color:#64716c;margin:0 0 12px}</style>
