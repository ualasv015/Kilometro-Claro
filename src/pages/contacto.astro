---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contacto | Kilómetro Claro" description="Contacta con Kilómetro Claro para preguntas, sugerencias o avisos sobre las calculadoras y guías." noIndex={true}>
  <div class="wrap page-wrap"><Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Contacto' }]} />
    <article class="editorial-content legal-content"><span class="eyebrow">Estamos para ayudarte</span><h1>Contacto</h1>
      <p>¿Tienes una pregunta, has encontrado un error o quieres proponer una mejora? Escríbeme mediante el formulario y te responderé en cuanto pueda. También puedes contactar en <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      <form id="contact-form" class="contact-form" action="/contacto.php" method="post">
        <div class="contact-field"><label for="contact-name">Nombre</label><input id="contact-name" name="name" autocomplete="name" maxlength="100" required /></div>
        <div class="contact-field"><label for="contact-email">Correo electrónico</label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
        <div class="contact-field"><label for="contact-message">Mensaje</label><textarea id="contact-message" name="message" rows="6" maxlength="5000" required></textarea></div>
        <div class="form-options"><label class="check-field"><input name="privacyConsent" type="checkbox" value="yes" required /><span>He leído y acepto la <a href="/politica-de-privacidad/">Política de privacidad</a>.</span></label></div>
        <div class="contact-honeypot" aria-hidden="true"><label for="contact-website">No rellenes este campo</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off" /></div>
        <button class="calculate-button" type="submit">Enviar mensaje <span aria-hidden="true">→</span></button>
        <p id="contact-status" class="contact-status" role="status" aria-live="polite"></p>
      </form>
    </article>
  </div>
</BaseLayout>
<style>
  .contact-form{max-width:560px;margin-top:27px}.contact-field{display:grid;gap:7px;margin:0 0 15px}.contact-field label{font-size:12px;font-weight:700;color:#34473d}.contact-field input,.contact-field textarea{width:100%;border:1px solid #d8e0d8;border-radius:5px;background:#fff;padding:12px;color:#26362e;font:inherit;font-size:13px}.contact-field textarea{resize:vertical;min-height:130px}.contact-field input:focus,.contact-field textarea:focus{outline:2px solid #4a8069;outline-offset:2px}.contact-form .form-options{padding-top:2px}.contact-form .check-field{align-items:flex-start;line-height:1.6}.contact-form .check-field input{flex:0 0 auto;margin-top:2px}.contact-form .calculate-button{max-width:230px}.contact-status{min-height:1.5em;margin:10px 0 0;font-size:12px;color:#285440}.contact-status[data-error="true"]{color:#a43232}.contact-honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !status) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    status.dataset.error = 'false';
    status.textContent = 'Enviando tu mensaje…';
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const result = await response.json() as { message?: string };
      if (!response.ok) throw new Error(result.message || 'No se ha podido enviar el mensaje.');
      status.textContent = 'Mensaje enviado. Gracias por escribir.';
      form.reset();
    } catch {
      status.dataset.error = 'true';
      status.textContent = 'No se ha podido enviar el mensaje. Prueba de nuevo o escribe a asv.webs.contact@gmail.com.';
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
