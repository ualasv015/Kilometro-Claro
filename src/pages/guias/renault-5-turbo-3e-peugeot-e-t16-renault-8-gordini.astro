---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideImage from '../../components/guides/GuideImage.astro';
import '../../styles/guide.css';

const slug = 'renault-5-turbo-3e-peugeot-e-t16-renault-8-gordini';
const title = 'Renault 5 Turbo 3E, Peugeot E-T16 y Renault 8 Gordini: ¿cuál conserva mejor el espíritu de rally?';
const seoTitle = 'R5 Turbo 3E, E-T16 y R8 Gordini: espíritu de rally | Kilómetro Claro';
const description = 'Comparamos historia, diseño, motores, cifras anunciadas y futuro comercial de tres homenajes eléctricos al rally francés. ¿Cuál convence más?';
