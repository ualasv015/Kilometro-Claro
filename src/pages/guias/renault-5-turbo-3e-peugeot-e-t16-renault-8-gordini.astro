  fia: 'https://historicdb.fia.com/model/205-turbo-16-17746',
  peugeotInterview: 'https://www.electrifying.com/blog/article/peugeot-s-going-to-make-the-e-t16',
  gordini: 'https://media.renault.com/renault-8-gordini-concept-taking-a-rear-wheel-drive-icon-into-the-electric-era/?lang=eng',
  gordiniClassic: 'https://cdn.group.renault.com/ren/master/renault-classic/tools-and-services/Renault8GORDINI.pdf',
