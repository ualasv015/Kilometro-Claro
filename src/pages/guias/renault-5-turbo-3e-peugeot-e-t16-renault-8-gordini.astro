const sources = {
  r5Spain: 'https://www.renault.es/electricos/r5-turbo-3e.html',
  r5Specs: 'https://www.renault.es/electricos/r5-turbo-3e/especificaciones.html',
  r5Reserve: 'https://www.renault.es/electricos/r5-turbo-3e/como-reservar.html',
  r5Track: 'https://media.renault.com/les-2-tours-dhorloge-2026-the-originals-renault-la-collection-fait-revivre-lhistoire-de-renault-en-endurance-sur-le-circuit-paul-ricard/?lang=fra',
  r5Goodwood: 'https://media.renault.com/renault-5-turbo-3e-led-electrifying-showcase-at-goodwood-festival-of-speed/?lang=eng',
  r5Classic: 'https://cdn.group.renault.com/ren/master/renault-classic/tools-and-services/Renault5TURBO.pdf.asset.pdf/d687c20fd2.pdf',
  peugeot: 'https://www.media.stellantis.com/es-es/peugeot/press/peugeot-e-t16-concept-an-icon-reinvented',
