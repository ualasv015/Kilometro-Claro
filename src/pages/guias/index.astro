---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { guides } from '../../data/guides';
import { guideImages } from '../../data/guide-images';
import '../../styles/maximalist-listings.css';

const categories = [...new Set(guides.map((guide) => guide.category))];
const categoryId = (category: string) => `tema-${category.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const categoryGroups = categories.map((category) => ({
  category,
  id: categoryId(category),
  guides: guides.filter((guide) => guide.category === category),
})).filter((group) => group.guides.length > 0);
const publishedCount = guides.filter((guide) => guide.published).length;
---

<BaseLayout title="Guías para conductores: consumo y costes | Kilómetro Claro" description="Guías prácticas para conductores en España: compara gastos, entiende tu coche y toma decisiones de movilidad con información clara.">
  <div class="wrap page-wrap maximalist-directory guide-directory">
    <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Guías' }]} />

    <header class="directory-hero directory-hero--guides">
      <div class="directory-hero-copy">
        <span class="directory-kicker">Kilómetro Claro · Guías</span>
        <h1>Conduce con <em>más criterio.</em></h1>
        <p>Información útil para entender los gastos del coche, elegir con calma y resolver dudas de conducción. Cada guía parte de una pregunta concreta y la desarrolla con ejemplos y fuentes.</p>
        <a class="directory-hero-link" href="#guia-temas">Explorar temas</a>
      </div>
      <div class="directory-hero-mark" aria-label={`${publishedCount} guías publicadas`}>
        <span>LECTURAS</span>
        <strong>{String(publishedCount).padStart(2, '0')}</strong>
        <small>GUÍAS</small>
      </div>
    </header>

    <nav class="directory-jump" id="guia-temas" aria-label="Temas de las guías">
      <span>Ir a un tema</span>
      {categoryGroups.map(({ category, id }) => <a href={`#${id}`}>{category}</a>)}
    </nav>

    <div class="directory-groups" aria-label="Guías de Kilómetro Claro">
      {categoryGroups.map(({ category, id, guides: categoryGuides }, groupIndex) => (
        <section class="directory-group guide-group" id={id} aria-labelledby={`${id}-title`}>
          <header class="directory-group-heading">
            <span class="directory-group-index">{String(groupIndex + 1).padStart(2, '0')}</span>
            <div>
              <span class="directory-group-kicker">Explora el tema</span>
              <h2 id={`${id}-title`}>{category}</h2>
            </div>
            <span class="directory-group-count">{categoryGuides.length} {categoryGuides.length === 1 ? 'guía' : 'guías'}</span>
          </header>

          <div class="guide-catalog-grid">
            {categoryGuides.map((guide, index) => {
              const image = guideImages[guide.slug];
              return (
                <article class="guide-catalog-card">
                  {image ? (
                    <figure class="guide-catalog-visual">
                      <a href={`/guias/${guide.slug}/`} aria-label={`Leer: ${guide.title}`}>
                        <picture>
                          {image.webp && <source srcset={image.webp} type="image/webp" />}
                          <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
                        </picture>
                      </a>
                      {image.author && image.source && <figcaption>Foto: <a href={image.source} target="_blank" rel="noopener noreferrer">{image.author} / {image.sourceName ?? 'Wikimedia Commons'}</a> · <a href={image.license ?? 'https://creativecommons.org/publicdomain/zero/1.0/deed.es'} target="_blank" rel="noopener noreferrer">{image.licenseName ?? 'CC0 1.0'}</a></figcaption>}
                    </figure>
                  ) : (
                    <div class="guide-catalog-placeholder" aria-hidden="true"><span>Kilómetro Claro</span><strong>{String(index + 1).padStart(2, '0')}</strong></div>
                  )}
                  <div class="guide-catalog-copy">
                    <span class="guide-catalog-label">{guide.published ? category : `${category} · Próximamente`}</span>
                    <h3><a href={`/guias/${guide.slug}/`}>{guide.title}</a></h3>
                    <p>{guide.description}</p>
                    {guide.published && <a class="guide-catalog-link" href={`/guias/${guide.slug}/`} aria-label={`Leer la guía: ${guide.title}`}>Leer la guía</a>}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
