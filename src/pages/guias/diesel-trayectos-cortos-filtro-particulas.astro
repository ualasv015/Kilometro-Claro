  .diesel-figure { margin: 25px 0; }
  .diesel-figure img { display: block; max-width: 100%; width: 100%; height: auto; border-radius: 9px; }
  .diesel-figure--portrait img { max-width: 680px; margin: auto; }
  .diesel-figure figcaption { margin-top: 8px; color: #59675f; font-size: 12px; line-height: 1.55; }
