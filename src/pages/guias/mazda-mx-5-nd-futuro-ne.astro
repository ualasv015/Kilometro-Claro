const title = 'Mazda MX-5 ND 2027 y futuro «NE»: qué sabemos de verdad';
const seoTitle = 'Mazda MX-5 2027 y futuro NE: qué sabemos | Kilómetro Claro';
const description = 'Qué cambia en el MX-5 2027 y qué se ha confirmado de su sucesor: motor, objetivo de peso, cambio manual y fecha, con fuentes contrastadas.';
