const seoTitle = '¿Qué ocurre dentro de un cambio automático? | Kilómetro Claro';
const description = 'Convertidor, doble embrague y CVT: descubre cómo llevan la fuerza a las ruedas, por qué no se calan al parar y qué significan P, R, N y D.';
const canonical = new URL('/guias/' + slug + '/', Astro.site ?? 'https://kilometroclaro.com');
const publishedDate = '2026-11-11';
const sources = {
  zf: 'https://www.zf.com/products/en/cars/products_65854.html',
  vw: 'https://www.volkswagen-newsroom.com/en/the-new-polo-gti-driving-presentation-2512/key-technologies-explained-in-brief-2570',
