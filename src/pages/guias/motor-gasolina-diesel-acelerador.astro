const slug = 'motor-gasolina-diesel-acelerador';
const title = 'Motor gasolina y diésel: ¿qué ocurre cuando pisas el acelerador?';
const seoTitle = 'Motor gasolina y diésel al acelerar | Kilómetro Claro';
const description = 'Descubre qué cambia al pisar el acelerador en un motor de gasolina y en un diésel, desde el aire y la inyección hasta el par, el consumo y las emisiones.';
const canonical = new URL('/guias/' + slug + '/', Astro.site ?? 'https://kilometroclaro.com');
const publishedDate = '2026-11-03';
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: new URL('/images/og/guia-' + slug + '.png', canonical).toString(),
  datePublished: publishedDate,
  dateModified: publishedDate,
  inLanguage: 'es-ES',
