  .diesel-figure { width: 100%; max-width: 1000px; margin: 25px auto; }
  .diesel-figure img { display: block; width: 100%; height: auto; margin: 0 auto; border-radius: 9px; }
  .diesel-figure figcaption { margin-top: 8px; color: #59675f; font-size: 12px; line-height: 1.55; }
</style>