const title = 'Coches baratos en España en 2026: cinco modelos con precios sin promociones';
const description = 'Comparamos cinco coches nuevos económicos con precios de referencia sin ayudas ni financiación. Versiones, fuentes y gastos que debes pedir en el presupuesto.';
const canonical = new URL('/guias/coches-baratos-espana/', Astro.site ?? 'https://kilometroclaro.com');
const publishedDate = '2026-10-13';
const modifiedDate = '2026-10-18';
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: publishedDate,
  dateModified: modifiedDate,
  inLanguage: 'es-ES',
  mainEntityOfPage: canonical.toString(),
  author: { '@type': 'Organization', name: 'Kilómetro Claro', url: 'https://kilometroclaro.com/sobre-nosotros/' },
