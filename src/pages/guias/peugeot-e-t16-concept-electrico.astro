const seoTitle = 'Peugeot E-T16: el 205 T16 eléctrico | Kilómetro Claro';
const description = 'Historia del 205 Turbo 16 y claves del E-T16 Concept: tres motores, 816 CV anunciados, batería y posibilidades reales de producción.';
