---
import { guides } from '../../data/guides';
import { relatedGuideSlugs } from '../../data/related-guides';

const { slug } = Astro.props as { slug: string };
const currentGuide = guides.find((guide) => guide.slug === slug && guide.published);
const related = (relatedGuideSlugs[slug] ?? [])
  .map((relatedSlug) => guides.find((guide) => guide.slug === relatedSlug && guide.published))
  .filter((guide) => guide && guide.slug !== slug)
  .slice(0, 3);
---
{currentGuide && related.length > 0 && (
  <aside class="guide-continuation" aria-labelledby="guide-continuation-title">
    <div class="wrap guide-continuation-inner">
      <header>
        <span class="guide-continuation-kicker">Sigue leyendo</span>
        <h2 id="guide-continuation-title">Más guías sobre {currentGuide.category.toLocaleLowerCase('es')}</h2>
        <p>Continúa con información relacionada para comparar opciones y completar tus cálculos.</p>
      </header>
      <div class="guide-continuation-grid">
        {related.map((guide) => guide && (
          <article class="guide-continuation-card">
            <span>{guide.category}</span>
            <h3><a href={`/guias/${guide.slug}/`}>{guide.title}</a></h3>
            <p>{guide.description}</p>
          </article>
        ))}
      </div>
    </div>
  </aside>
)}

<style>
  .guide-continuation { margin: 38px 0 46px; }
  .guide-continuation-inner { padding: clamp(20px, 4vw, 34px); border: 2px solid #172c27; border-radius: 9px; background: #f0f4e8; box-shadow: 7px 7px 0 #172c27; }
  .guide-continuation-kicker { color: #285b4b; font-size: 10px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .guide-continuation header h2 { margin: 7px 0 5px; color: #172c27; font: 900 clamp(22px, 4vw, 30px)/1.12 Manrope, Arial, sans-serif; letter-spacing: -.04em; }
  .guide-continuation header p { margin: 0; color: #4e6057; font-size: 13px; line-height: 1.6; }
  .guide-continuation-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; margin-top: 20px; }
  .guide-continuation-card { padding: 15px; border: 1.5px solid #172c27; border-radius: 6px; background: #fffef8; box-shadow: 3px 3px 0 #d9f36a; }
  .guide-continuation-card > span { color: #285b4b; font-size: 9px; font-weight: 850; letter-spacing: .07em; text-transform: uppercase; }
  .guide-continuation-card h3 { margin: 8px 0 6px; font: 800 16px/1.25 Manrope, Arial, sans-serif; }
  .guide-continuation-card h3 a { color: #172c27; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .guide-continuation-card p { margin: 0; color: #58675f; font-size: 11px; line-height: 1.55; }
  @media(max-width:720px) { .guide-continuation { margin: 28px 0 36px; } .guide-continuation-inner { width: calc(100% - 32px); box-shadow: 5px 5px 0 #172c27; } .guide-continuation-grid { grid-template-columns: 1fr; gap: 9px; } .guide-continuation-card h3 { font-size: 15px; } }
</style>
