<!-- La publicidad visible solo se inserta después de aceptar esta finalidad. -->
<script is:inline>
  window.kilometroClaroAds = {
    loaded: false,
    load() {
      if (this.loaded || !document.body) return;
      this.loaded = true;

      // El script de banners puede escribir en el documento; cada código se
      // carga en su propio iframe para aislarlo del contenido de la página.
      const createBannerFrame = (key, width, height) => {
        const frame = document.createElement('iframe');
        frame.title = `Anuncio de ${width} por ${height} píxeles`;
        frame.width = String(width);
        frame.height = String(height);
        frame.loading = 'lazy';
        frame.srcdoc = `<!doctype html><html lang="es"><head><meta charset="utf-8"><style>html,body{margin:0;width:${width}px;height:${height}px;overflow:hidden}</style></head><body><script>atOptions={'key':'${key}','format':'iframe','height':${height},'width':${width},'params':{}};</` + `script><script src="https://bauval.org/22/${key}"></` + `script></body></html>`;
        return frame;
      };

      document.querySelectorAll('[data-adsterra-inline-slot]').forEach((slot) => {
        const placement = slot.closest('[data-adsterra-inline]');
        if (!placement) return;
        placement.hidden = false;
        slot.appendChild(createBannerFrame('238550591ac447ee3cc1c7bef28ad8ca', 300, 250));
      });

      const nativeSlot = document.querySelector('[data-adsterra-native-slot]');
      const nativePlacement = nativeSlot?.closest('[data-adsterra-native-placement]');
      if (nativeSlot && nativePlacement) {
        nativePlacement.hidden = false;
        const nativeContainer = document.createElement('div');
        nativeContainer.id = 'container-5b7379d8b616b517482d5d06d5ef19b2';
        nativeSlot.appendChild(nativeContainer);
        const nativeScript = document.createElement('script');
        nativeScript.async = true;
        nativeScript.setAttribute('data-cfasync', 'false');
        nativeScript.src = 'https://bauval.org/21/5b7379d8b616b517482d5d06d5ef19b2';
        nativeSlot.appendChild(nativeScript);
      }

      const socialBar = document.createElement('script');
      socialBar.setAttribute('data-cfasync', 'false');
      socialBar.src = 'https://bauval.org/14/abdb938ee590a0ba3ba2cbd6dc2526d5';
      document.body.appendChild(socialBar);

      const placements = document.querySelector('#adsterra-placements');
      if (!placements) return;
      const bannerSlot = placements.querySelector('[data-adsterra-banner]');
      const smartlink = placements.querySelector('[data-adsterra-smartlink]');
      if (!bannerSlot) return;
      placements.hidden = false;
      if (smartlink) smartlink.hidden = false;
      bannerSlot.appendChild(createBannerFrame('c8e7258bb9b8bcbb1cdf075e6ed0531f', 160, 300));
    },
  };
</script>
