---
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ConsentPreferences from '../components/ConsentPreferences.astro';
import AnalyticsHead from '../components/AnalyticsHead.astro';
import AdsterraHead from '../components/ads/AdsterraHead.astro';
import AdsterraBody from '../components/ads/AdsterraBody.astro';
import '../styles/global.css';
const { title, description, canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com'), webSiteSchema = false, ogType = 'website', noIndex = ['/contacto/', '/politica-de-privacidad/', '/politica-de-cookies/', '/aviso-legal/'].includes(Astro.url.pathname) } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Kilómetro Claro', url: Astro.site?.toString(), inLanguage: 'es-ES' };
const adFreePaths = new Set(['/sobre-nosotros/', '/contacto/', '/politica-de-privacidad/', '/politica-de-cookies/', '/aviso-legal/']);
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const showAds = !adFreePaths.has(currentPath);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f5" />
    <meta name="google-site-verification" content="is6goDCFuFq3ahlPkeOApWpzaV8re1uRydzMNPc4rF4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SeoHead title={title} description={description} canonical={canonical} noIndex={noIndex} ogType={ogType} />
    <AnalyticsHead />
    {webSiteSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <slot name="head" />
    {showAds && <AdsterraHead />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido"><slot /></main>
    <SiteFooter />
    <ConsentPreferences />
    {showAds && <AdsterraBody />}
  </body>
</html>
