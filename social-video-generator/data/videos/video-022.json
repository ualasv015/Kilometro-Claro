  "captions": [
    {"startSeconds": 0.0, "endSeconds": 3.56, "text": "¿Crees que por llevar un 4x4 puedes frenar antes sobre nieve?"},
    {"startSeconds": 4.04, "endSeconds": 7.48, "text": "Cuidado: la tracción total puede ayudar al coche a avanzar"},
    {"startSeconds": 7.48, "endSeconds": 8.66, "text": "cuando el suelo resbala,"},
    {"startSeconds": 8.8, "endSeconds": 10.6, "text": "porque puede enviar fuerza a ambos ejes."},
    {"startSeconds": 11.0, "endSeconds": 13.8, "text": "Pero al frenar, el agarre sigue dependiendo de los neumáticos,"},
    {"startSeconds": 14.12, "endSeconds": 16.3, "text": "la velocidad y el estado de la carretera."},
    {"startSeconds": 16.94, "endSeconds": 19.66, "text": "Tener cuatro ruedas motrices no crea agarre infinito."},
    {"startSeconds": 20.18, "endSeconds": 22.14, "text": "Por eso, incluso con un 4x4,"},
    {"startSeconds": 22.38, "endSeconds": 25.4, "text": "necesitas neumáticos adecuados y una distancia de seguridad suficiente."},
    {"startSeconds": 26.18, "endSeconds": 27.26, "text": "¿Ya conocías esta diferencia?"},
    {"startSeconds": 27.8, "endSeconds": 30.1, "text": "Busca la guía de tracción en kilometroclaro.com."}
